# Copiá a .env solo si tu backend corre en otro puerto/host. No hace falta
# para correr el proyecto: el código ya trae localhost:3000 como default.
VITE_API_URL="http://localhost:3000"

# Mismo Client ID que GOOGLE_CLIENT_ID en backend/.env.example. Opcional:
# sin esto, el botón de Google directamente no aparece.
VITE_GOOGLE_CLIENT_ID=""
