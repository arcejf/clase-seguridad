{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de una red social mínima, proyecto didáctico de buenas prácticas de seguridad (auth con JWT, hashing, CORS, validación, etc.)",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.ts",
  "scripts": {
    "setup": "tsx scripts/setup.ts && prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "dev": "tsx watch main.ts",
    "start": "tsx main.ts",
    "db:reset": "tsx scripts/db-reset.ts && npm run setup",
    "prisma:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
