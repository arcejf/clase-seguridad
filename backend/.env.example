# Copiá este archivo a .env y completá los valores.
# `npm run setup` hace esto automáticamente y genera un JWT_SECRET aleatorio,
# así que en general no hace falta tocar este archivo a mano.
#
# Este archivo (.env.example) sí se commitea a git: documenta qué variables
# existen, pero con valores de ejemplo, nunca secretos reales. El .env real
# está en .gitignore y nunca debería llegar al repo.

# Puerto en el que escucha la API.
PORT=3000

# Entorno de ejecución. En "production" los errores no muestran stack trace.
NODE_ENV=development

# Conexión de Prisma a SQLite, un archivo local, no requiere servidor de BD.
DATABASE_URL="file:./dev.db"

# Origen exacto desde el que el frontend hace requests (CORS whitelist).
# Nunca "*" cuando se usan cookies o credentials: el navegador ni lo permite.
CORS_ORIGIN="http://localhost:5173"

# Secreto para firmar los JWT (access y refresh). Mínimo 32 caracteres.
# `npm run setup` genera uno random con crypto.randomBytes: nunca hardcodear
# este valor ni reusar el de otro proyecto.
JWT_SECRET="reemplazar_con_un_secreto_de_al_menos_32_caracteres_random"

# Duración del access token (corto: minimiza la ventana de robo).
JWT_ACCESS_EXPIRES_IN="15m"

# Duración del refresh token (más largo, pero revocable en la BD).
JWT_REFRESH_EXPIRES_IN="7d"

# Rate limiting de /auth/login y /auth/register (fuerza bruta).
# 5 intentos cada 15 min es el valor recomendado en producción. Subilo solo
# para hacer una demo en clase sin comerte el límite en cada prueba: nunca
# lo subas en un despliegue real.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Rate limiting general para el resto de /api/*.
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Client ID de una credencial OAuth 2.0 de tipo "Aplicación web" en Google
# Cloud Console, con http://localhost:5173 como origen de JavaScript
# autorizado. Opcional: sin esto, todo el resto de la API funciona igual,
# simplemente no vas a poder loguearte con Google.
GOOGLE_CLIENT_ID=""
