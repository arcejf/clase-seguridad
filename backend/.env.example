# Copiá este archivo a .env. `npm run setup` lo hace solo y genera un
# JWT_SECRET random, así que normalmente no hace falta tocarlo a mano.

PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Nunca "*" cuando se usan cookies.
CORS_ORIGIN="http://localhost:5173"

# Mínimo 32 caracteres, nunca hardcodeado.
JWT_SECRET="reemplazar_con_un_secreto_de_al_menos_32_caracteres_random"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# En un despliegue real van las URLs reales del backend y del frontend.
JWT_ISSUER="localhost:3000"
JWT_AUDIENCE="localhost:5173"

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Opcional: sin esto, el login con Google queda desactivado pero el resto de la API funciona igual.
GOOGLE_CLIENT_ID=""
